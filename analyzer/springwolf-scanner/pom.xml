<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standalone-сканер Springwolf: снимает AsyncAPI с чужого Spring Boot fat-jar
  без запуска (BOOT-INF/classes жертвы на classpath). Отдельный проект, НЕ модуль
  анализатора: свой Spring-стек, конфликтующий с Ktor/Kotlin анализатора.

  Собрать один раз: mvn -q -f analyzer/springwolf-scanner/pom.xml package
  (полка springwolf применима, когда есть target/classes + target/cp.txt).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>arch.analyzer</groupId>
    <artifactId>springwolf-scanner</artifactId>
    <version>0.1.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springwolf.version>2.6.0</springwolf.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>4.1.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- springwolf-kafka 2.6.0 тянет kafka-clients 8.3.0-ce (Confluent-репозиторий);
                 пиним версию из Maven Central -->
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>3.9.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.springwolf</groupId>
            <artifactId>springwolf-kafka</artifactId>
            <version>${springwolf.version}</version>
        </dependency>
        <!-- @RabbitListener: наш стек — Kafka+Rabbit, один сканер кроет оба -->
        <dependency>
            <groupId>io.github.springwolf</groupId>
            <artifactId>springwolf-amqp</artifactId>
            <version>${springwolf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.3</version>
        </dependency>
        <!-- snakeyaml — чтобы ConfigData подхватил application.yml жертвы -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.3</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- classpath зависимостей в target/cp.txt: полка склеивает его
                 с target/classes и BOOT-INF жертвы при каждом прогоне -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>write-classpath</id>
                        <phase>package</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <outputFile>${project.build.directory}/cp.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
