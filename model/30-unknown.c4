/**
 * Система-приёмник нераспознанных целей. Анализатор складывает сюда stub'ы:
 * «мы знаем эндпоинты, но не знаем, чей это сервис». Склейка с реальным
 * контейнером (registry/resolutions.yml или автоматика по совпадению
 * эндпоинтов) убирает stub отсюда. Содержимое — только в model/gen/unknown/.
 */
model {

  unknown = orgSystem 'Непознанное' {
    #stub
    description 'Цели вызовов, чьё имя ещё не установлено. Разбор — экран триажа в UI анализатора'
  }
}
