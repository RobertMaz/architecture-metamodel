            params 'petId:path:int'
            responses 'Visit'
            source 'actuator:/mappings; src/main/java/org/springframework/samples/petclinic/visits/web/VisitResource.java#L67; spring-petclinic-visits-service-4.0.1.jar!org.springframework.samples.petclinic.visits.web.VisitResource#read; src/main/java/org/springframework/samples/petclinic/visits/web/VisitResource.java:67; llm:enrich'
