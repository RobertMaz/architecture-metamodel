            source 'src/main/java/org/springframework/samples/petclinic/api/boundary/web/FallbackController.java#FallbackController.fallback; src/main/java/org/springframework/samples/petclinic/api/boundary/web/FallbackController.java#L11; spring-petclinic-api-gateway-4.0.1.jar!org.springframework.samples.petclinic.api.boundary.web.FallbackController#fallback; src/main/java/org/springframework/samples/petclinic/api/boundary/web/FallbackController.java:11; llm:enrich'
