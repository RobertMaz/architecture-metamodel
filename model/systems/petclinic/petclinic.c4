            confidence '1'
          }
        }

        post_owners_p_pets = operation 'POST /owners/{ownerId}/pets' {
          #inferred
          description 'Добавить питомца владельцу'
          metadata {
            method 'POST'
            path '/owners/{ownerId}/pets'
            params 'ownerId:path:int'
            request 'PetRequest'
            responses 'Pet'
            source 'actuator:/mappings; src/main/java/org/springframework/samples/petclinic/customers/web/PetResource.java#PetResource.processCreationForm; src/main/java/org/springframework/samples/petclinic/customers/web/PetResource.java#L54; spring-petclinic-customers-service-4.0.1.jar!org.springframework.samples.petclinic.customers.web.PetResource#processCreationForm; src/main/java/org/springframework/samples/petclinic/customers/web/PetResource.java:54; llm:enrich'
            confidence '1'
          }
        }

        get_petTypes = operation 'GET /petTypes' {
          #inferred
          description 'Список типов питомцев'
          metadata {
            method 'GET'
            path '/petTypes'
            responses 'PetType'
            source 'actuator:/mappings; src/main/java/org/springframework/samples/petclinic/customers/web/PetResource.java#PetResource.getPetTypes; src/main/java/org/springframework/samples/petclinic/customers/web/PetResource.java#L49; spring-petclinic-customers-service-4.0.1.jar!org.springframework.samples.petclinic.customers.web.PetResource#getPetTypes; src/main/java/org/springframework/samples/petclinic/customers/web/PetResource.java:49; llm:enrich'
            confidence '1'
          }
        }
      }
    }

    discovery = service 'discovery-server' {
      #inferred
      technology 'Java, Spring Boot'
      link https://github.com/spring-petclinic/spring-petclinic-microservices 'repo'
      metadata {
        app-name 'discovery-server'
        repo 'https://github.com/spring-petclinic/spring-petclinic-microservices'
        commit '9a76b4e'
        extracted-at '2026-08-19'
      }

      api = api 'discovery-server API' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          base-path '/'
        }

        get = operation 'GET /' {
          #inferred
          metadata {
            method 'GET'
            path '/'
            source 'actuator:/mappings'
            confidence '0.97'
          }
        }
      }

      api_lastn = api 'lastn' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'lastn'
        }

        get_lastn = operation 'GET /lastn' {
          #inferred
          metadata {
            method 'GET'
            path '/lastn'
            source 'actuator:/mappings'
            confidence '0.97'
          }
        }
      }
    }

    gateway = service 'api-gateway' {
      #inferred
      description 'Шлюз PetClinic для маршрутизации запросов к владельцам и резервной обработки.'
      technology 'Java, Spring Boot'
      link https://github.com/spring-petclinic/spring-petclinic-microservices 'repo'
