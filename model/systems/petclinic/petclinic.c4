    visits = service 'visits-service' {
      #inferred
      description 'API для работы с визитами питомцев в сервисе petclinic.visits.'
      technology 'Java, Spring Boot'
      link https://github.com/spring-petclinic/spring-petclinic-microservices 'repo'
      metadata {
        app-name 'visits-service'
        repo 'https://github.com/spring-petclinic/spring-petclinic-microservices'
        commit '9a76b4e'
        extracted-at '2026-08-19'
      }

      api = api 'visits-service API' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          base-path '/'
        }
      }

      api_owners = api 'owners' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'owners'
        }

        getowners_pets_p_visits = operation 'GET owners/*/pets/{petId}/visits' {
          #inferred
