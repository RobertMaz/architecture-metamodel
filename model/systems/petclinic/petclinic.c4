            responses 'Vet'
            source 'actuator:/mappings; src/main/java/org/springframework/samples/petclinic/vets/web/VetResource.java#VetResource.showResourcesVetList; src/main/java/org/springframework/samples/petclinic/vets/web/VetResource.java#L44; spring-petclinic-vets-service-4.0.1.jar!org.springframework.samples.petclinic.vets.web.VetResource#showResourcesVetList; src/main/java/org/springframework/samples/petclinic/vets/web/VetResource.java:44; llm:enrich'
