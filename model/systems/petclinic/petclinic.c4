      api_visit = api 'visit' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'visit'
        }

        get_owners_pets_p_visits = operation 'GET /owners/*/pets/{petId}/visits' {
          #inferred
          description 'Получить список визитов конкретного питомца владельца.'
          metadata {
            method 'GET'
