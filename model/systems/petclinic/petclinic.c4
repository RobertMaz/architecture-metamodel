  petclinic.admin -[call]-> petclinic.config
  petclinic.admin -[call]-> petclinic.discovery.api
  petclinic.config -[call]-> github_config_repo
  petclinic.customers -[call]-> petclinic.config
  petclinic.customers -[call]-> petclinic.config 'GET /customers-service/default'
  petclinic.customers -[call]-> petclinic.discovery.api
  petclinic.customers -[call]-> petclinic.discovery.api 'GET /eureka/apps/'
  petclinic.customers -[call]-> petclinic.discovery.api 'GET /eureka/apps/delta'
  petclinic.customers -[call]-> petclinic.discovery.api 'POST /eureka/apps/CUSTOMERS-SERVICE'
  petclinic.customers -[call]-> petclinic.discovery.api 'PUT /eureka/apps/CUSTOMERS-SERVICE/customers-service:324df86a-1d79-4dc2-91b1-3270152d33d2'
  petclinic.customers -[call]-> zipkin 'POST /api/v2/spans'
  petclinic.customers -[read]-> petclinic.db_customers
  petclinic.customers -[write]-> petclinic.db_customers
  petclinic.discovery -[call]-> petclinic.config
  petclinic.gateway -[call]-> petclinic.config
  petclinic.gateway -[call]-> petclinic.config 'GET /api-gateway/default'
  petclinic.gateway -[call]-> petclinic.customers.api 'route /api/customer/**'
  petclinic.gateway -[call]-> petclinic.customers.api_owner.get_owners 'GET /owners'
  petclinic.gateway -[call]-> petclinic.customers.api_owner.get_owners_p 'GET /owners/{_}'
  petclinic.gateway -[call]-> petclinic.discovery.api
  petclinic.gateway -[call]-> petclinic.discovery.api 'GET /eureka/apps/'
  petclinic.gateway -[call]-> petclinic.discovery.api 'POST /eureka/apps/API-GATEWAY'
  petclinic.gateway -[call]-> petclinic.genai.api 'route /api/genai/**'
  petclinic.gateway -[call]-> petclinic.vets.api 'route /api/vet/**'
  petclinic.gateway -[call]-> petclinic.vets.api_vet.get_vets 'GET /vets'
  petclinic.gateway -[call]-> petclinic.visits.api 'GET'
  petclinic.gateway -[call]-> petclinic.visits.api 'route /api/visit/**'
  petclinic.gateway -[call]-> petclinic.visits.api_visit.get_pets_visits 'GET /pets/visits'
  petclinic.gateway -[call]-> zipkin 'POST /api/v2/spans'
  petclinic.genai -[call]-> petclinic.config
  petclinic.genai -[call]-> petclinic.customers.api_owner.get_owners 'GET /owners'
  petclinic.genai -[call]-> petclinic.customers.api_owner.post_owners 'POST /owners'
  petclinic.genai -[call]-> petclinic.customers.api_pet.post_owners_p_pets 'POST /owners/{ownerId}/pets'
  petclinic.genai -[call]-> petclinic.discovery.api
  petclinic.genai -[call]-> petclinic.vets.api 'GET'
  petclinic.genai -[call]-> petclinic.vets.api_vet.get_vets 'GET /vets'
  petclinic.vets -[call]-> petclinic.config
  petclinic.vets -[call]-> petclinic.discovery.api
  petclinic.vets -[read]-> petclinic.db_vets
  petclinic.vets -[write]-> petclinic.db_vets
  petclinic.visits -[call]-> petclinic.config
  petclinic.visits -[call]-> petclinic.discovery.api
  petclinic.visits -[read]-> petclinic.db_visits
  petclinic.visits -[write]-> petclinic.db_visits
}

views 'PetClinic' {

  view petclinic_containers of petclinic {
    title 'Контейнеры'
    description 'Кто с кем связан. Отсюда видно радиус изменения'
    global predicate noContracts
    include *
    include github_config_repo
    include petclinic <-> github_config_repo
    include zipkin
    include petclinic <-> zipkin
    global style base
    autoLayout TopBottom
  }

  view petclinic_customers_api of petclinic.customers {
    title 'API / customers-service'
    description 'Три уровня разом: контейнер, его api-группы и операции с вызывающими'
    include *
    include petclinic.customers.**
    include * -> petclinic.customers.**
