// Файл ведёт генератор (registry/systems.yml + tools/api-source/*.json).
// Править руками МОЖНО, но регенерация перезапишет: закоммиченные правки
// вытаскивай обратно через git diff, незакоммиченные — из workspace/_backup/.
// Вся кухня системы в одном файле: контейнеры, сторы, каналы, связи, виды.

model {

  petclinic = system 'PetClinic' {
    description 'Демо-ландшафт Spring PetClinic (пилот анализатора)'

    admin = service 'admin-server' {
      #inferred
      technology 'Java, Spring Boot'
      link https://github.com/spring-petclinic/spring-petclinic-microservices 'repo'
      metadata {
        app-name 'admin-server'
        repo 'https://github.com/spring-petclinic/spring-petclinic-microservices'
        commit '9a76b4e'
        extracted-at '2026-08-19'
      }
    }

    config = service 'config' {
      #inferred
      technology 'Java, Spring Boot'
      link https://github.com/spring-petclinic/spring-petclinic-microservices 'repo'
      metadata {
        repo 'https://github.com/spring-petclinic/spring-petclinic-microservices'
        commit '9a76b4e'
        extracted-at '2026-08-19'
      }
    }

    customers = service 'customers-service' {
      #inferred
      description 'API для управления владельцами и их питомцами в сервисе petclinic.customers.'
      technology 'Java, Spring Boot'
      link https://github.com/spring-petclinic/spring-petclinic-microservices 'repo'
      metadata {
        app-name 'customers-service'
        repo 'https://github.com/spring-petclinic/spring-petclinic-microservices'
        commit '9a76b4e'
        extracted-at '2026-08-19'
      }

      api = api 'customers-service API' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          base-path '/'
        }
      }

      api_owner = api 'owner' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'owner'
        }

        get_owners = operation 'GET /owners' {
          #inferred
          description 'Список владельцев'
          metadata {
            method 'GET'
            path '/owners'
            responses 'Owner'
            source 'actuator:/mappings; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java#OwnerResource.findAll; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java#L75; spring-petclinic-customers-service-4.0.1.jar!org.springframework.samples.petclinic.customers.web.OwnerResource#findAll; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java:75; llm:enrich'
            confidence '1'
          }
        }

        post_owners = operation 'POST /owners' {
          #inferred
          description 'Создать владельца'
          metadata {
            method 'POST'
            path '/owners'
            request 'OwnerRequest'
            responses 'Owner'
            source 'actuator:/mappings; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java#OwnerResource.createOwner; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java#L57; spring-petclinic-customers-service-4.0.1.jar!org.springframework.samples.petclinic.customers.web.OwnerResource#createOwner; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java:57; llm:enrich'
            confidence '1'
          }
        }

        get_owners_p = operation 'GET /owners/{ownerId}' {
          #inferred
          description 'Получить владельца по идентификатору'
          metadata {
            method 'GET'
            path '/owners/{ownerId}'
            params 'ownerId:path:int'
            responses 'Owner'
            source 'actuator:/mappings; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java#OwnerResource.findOwner; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java#L67; spring-petclinic-customers-service-4.0.1.jar!org.springframework.samples.petclinic.customers.web.OwnerResource#findOwner; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java:67; llm:enrich'
            confidence '1'
          }
        }

        put_owners_p = operation 'PUT /owners/{ownerId}' {
          #inferred
          description 'Обновить владельца'
          metadata {
            method 'PUT'
            path '/owners/{ownerId}'
            params 'ownerId:path:int'
            request 'OwnerRequest'
            source 'actuator:/mappings; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java#OwnerResource.updateOwner; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java#L83; spring-petclinic-customers-service-4.0.1.jar!org.springframework.samples.petclinic.customers.web.OwnerResource#updateOwner; src/main/java/org/springframework/samples/petclinic/customers/web/OwnerResource.java:83; llm:enrich'
            confidence '1'
          }
        }
      }

      api_owners = api 'owners' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'owners'
        }

        getowners_pets_p = operation 'GET owners/*/pets/{petId}' {
          #inferred
          metadata {
            method 'GET'
            path 'owners/*/pets/{petId}'
            source 'src/main/java/org/springframework/samples/petclinic/customers/web/PetResource.java#PetResource.findPet'
            confidence '0.85'
