      api_pet = api 'pet' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'pet'
        }

        get_owners_pets_p = operation 'GET /owners/*/pets/{petId}' {
          #inferred
          description 'Получить питомца владельца по идентификатору'
          metadata {
            method 'GET'
            path '/owners/*/pets/{petId}'
            params 'petId:path:int'
            responses 'PetDetails'
            source 'actuator:/mappings; src/main/java/org/springframework/samples/petclinic/customers/web/PetResource.java#L88; spring-petclinic-customers-service-4.0.1.jar!org.springframework.samples.petclinic.customers.web.PetResource#findPet; src/main/java/org/springframework/samples/petclinic/customers/web/PetResource.java:88; llm:enrich'
