    db_customers = store 'customers' {
      #inferred
      technology 'hsqldb'
      metadata {
        entities 'Owner, Pet'
      }
    }

    db_vets = store 'vets' {
      #inferred
      technology 'JDBC'
      metadata {
        entities 'Vet'
      }
    }

    db_visits = store 'visits' {
      #inferred
      technology 'JDBC'
