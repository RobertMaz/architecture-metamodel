        get_api_gateway_owners_p = operation 'GET /api/gateway/owners/{ownerId}' {
          #inferred
          description 'Получает данные владельца по идентификатору.'
          metadata {
            method 'GET'
            path '/api/gateway/owners/{ownerId}'
            params 'ownerId:path:int'
            responses 'OwnerDetails'
            source 'src/main/java/org/springframework/samples/petclinic/api/boundary/web/ApiGatewayController.java#ApiGatewayController.getOwnerDetails; src/main/java/org/springframework/samples/petclinic/api/boundary/web/ApiGatewayController.java#L54; spring-petclinic-api-gateway-4.0.1.jar!org.springframework.samples.petclinic.api.boundary.web.ApiGatewayController#getOwnerDetails; src/main/java/org/springframework/samples/petclinic/api/boundary/web/ApiGatewayController.java:54; llm:enrich'
            confidence '1'
          }
        }
      }

      api_fallback = api 'fallback' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'fallback'
        }

        post_fallback = operation 'POST /fallback' {
          #inferred
          description 'Выполняет резервную обработку запроса при недоступности основного сервиса.'
