          metadata {
            method 'DELETE'
            path '/api/pets/{petId}'
            params 'petId:path:integer'
            responses 'Pet'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        get_api_pets_p = operation 'GET /api/pets/{petId}' {
          #inferred
          description 'Get a pet by ID'
          metadata {
            method 'GET'
            path '/api/pets/{petId}'
            params 'petId:path:integer'
            responses 'Pet'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        put_api_pets_p = operation 'PUT /api/pets/{petId}' {
          #inferred
          description 'Update a pet by ID'
          metadata {
            method 'PUT'
            path '/api/pets/{petId}'
            params 'petId:path:integer'
            request 'Pet'
            responses 'Pet'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }
      }

      api_pettypes = api 'pettypes' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'pettypes'
        }

        get_api_pettypes = operation 'GET /api/pettypes' {
          #inferred
          description 'Lists pet types'
          metadata {
            method 'GET'
            path '/api/pettypes'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
