        get_api_visits_p = operation 'GET /api/visits/{visitId}' {
          #inferred
          description 'Get a visit by ID'
          metadata {
            method 'GET'
            path '/api/visits/{visitId}'
            params 'visitId:path:integer'
            responses 'Visit'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
