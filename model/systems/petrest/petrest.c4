// Файл ведёт генератор (registry/systems.yml + tools/api-source/*.json).
// Править руками МОЖНО, но регенерация перезапишет: закоммиченные правки
// вытаскивай обратно через git diff, незакоммиченные — из workspace/_backup/.
// Вся кухня системы в одном файле: контейнеры, сторы, каналы, связи, виды.

model {

  petrest = system 'PetClinic REST' {
    description 'Монолитный REST-бэкенд petclinic (пилот полки openapi)'

    backend = service 'backend' {
      #inferred
      description 'Сервис petrest.backend предоставляет базовую информацию о сервисе.'
      technology 'Java, Spring Boot'
      link https://github.com/spring-petclinic/spring-petclinic-rest 'repo'
      metadata {
        repo 'https://github.com/spring-petclinic/spring-petclinic-rest'
        commit '698bd83'
        extracted-at '2026-08-18'
      }

      api = api 'backend API' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          base-path '/'
        }

        get_swagger_ui_html = operation 'GET /swagger-ui.html' {
          #inferred
          metadata {
            method 'GET'
            path '/swagger-ui.html'
            source 'actuator:/mappings'
            confidence '0.97'
          }
        }

        get_v3_api_docs = operation 'GET /v3/api-docs' {
          #inferred
          metadata {
            method 'GET'
            path '/v3/api-docs'
            source 'actuator:/mappings'
            confidence '0.97'
          }
        }

        get_v3_api_docs_yaml = operation 'GET /v3/api-docs.yaml' {
          #inferred
          metadata {
            method 'GET'
            path '/v3/api-docs.yaml'
            source 'actuator:/mappings'
            confidence '0.97'
          }
        }

        get_v3_api_docs_swagger_config = operation 'GET /v3/api-docs/swagger-config' {
          #inferred
          metadata {
            method 'GET'
            path '/v3/api-docs/swagger-config'
            source 'actuator:/mappings'
            confidence '0.97'
          }
        }
      }

      api_oops = api 'oops' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'oops'
        }

        get_api_oops = operation 'GET /api/oops' {
          #inferred
          description 'Always fails'
          metadata {
            method 'GET'
            path '/api/oops'
            source 'src/main/resources/openapi.yml'
            confidence '0.95'
          }
        }
      }

      api_owner_v2 = api 'owner-v2' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'owner-v2'
        }

        get_api_v2_owners = operation 'GET /api/v2/owners' {
          #inferred
          description 'Lists pet owners with pagination'
          metadata {
            method 'GET'
            path '/api/v2/owners'
            params 'lastName:query:string?, page:query:integer?, size:query:integer?'
            responses 'OwnerPage'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }
      }

      api_owners = api 'owners' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'owners'
        }

        get_api_owners = operation 'GET /api/owners' {
          #inferred
          description 'Lists pet owners'
          metadata {
            method 'GET'
            path '/api/owners'
            params 'lastName:query:string?'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        post_api_owners = operation 'POST /api/owners' {
          #inferred
          description 'Adds a pet owner'
          metadata {
            method 'POST'
            path '/api/owners'
            request 'OwnerFields'
            responses 'Owner'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        delete_api_owners_p = operation 'DELETE /api/owners/{ownerId}' {
          #inferred
          description 'Delete an owner by ID'
          metadata {
            method 'DELETE'
            path '/api/owners/{ownerId}'
            params 'ownerId:path:integer'
            responses 'Owner'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        get_api_owners_p = operation 'GET /api/owners/{ownerId}' {
          #inferred
          description 'Get a pet owner by ID'
          metadata {
            method 'GET'
            path '/api/owners/{ownerId}'
            params 'ownerId:path:integer'
            responses 'Owner'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        put_api_owners_p = operation 'PUT /api/owners/{ownerId}' {
          #inferred
          description 'Update a pet owner\'s details'
          metadata {
            method 'PUT'
            path '/api/owners/{ownerId}'
            params 'ownerId:path:integer'
            request 'OwnerFields'
            responses 'Owner'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        post_api_owners_p_pets = operation 'POST /api/owners/{ownerId}/pets' {
          #inferred
          description 'Adds a pet to an owner'
          metadata {
            method 'POST'
            path '/api/owners/{ownerId}/pets'
            params 'ownerId:path:integer'
            request 'PetFields'
            responses 'Pet'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        get_api_owners_p_pets_p = operation 'GET /api/owners/{ownerId}/pets/{petId}' {
          #inferred
          description 'Get a pet by ID'
          metadata {
            method 'GET'
            path '/api/owners/{ownerId}/pets/{petId}'
            params 'ownerId:path:integer, petId:path:integer'
            responses 'Pet'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        put_api_owners_p_pets_p = operation 'PUT /api/owners/{ownerId}/pets/{petId}' {
          #inferred
          description 'Update a pet\'s details'
          metadata {
            method 'PUT'
            path '/api/owners/{ownerId}/pets/{petId}'
            params 'ownerId:path:integer, petId:path:integer'
            request 'PetFields'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        post_api_owners_p_pets_p_visits = operation 'POST /api/owners/{ownerId}/pets/{petId}/visits' {
          #inferred
          description 'Adds a vet visit'
          metadata {
            method 'POST'
            path '/api/owners/{ownerId}/pets/{petId}/visits'
            params 'ownerId:path:integer, petId:path:integer'
            request 'VisitFields'
            responses 'Visit'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }
      }

      api_pet_v2 = api 'pet-v2' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'pet-v2'
        }

        get_api_v2_pets = operation 'GET /api/v2/pets' {
