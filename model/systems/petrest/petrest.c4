    }

    db_backend = store 'backend' {
      #inferred
      technology 'JDBC'
      metadata {
        entities 'Owner, Pet, PetType, Specialty, User, Vet, Visit'
      }
    }
  }

  petrest.backend -[read]-> petrest.db_backend
  petrest.backend -[write]-> petrest.db_backend
}

views 'PetClinic REST' {

  view petrest_containers of petrest {
    title 'Контейнеры'
    description 'Кто с кем связан. Отсюда видно радиус изменения'
    include *
    global predicate noContracts
    global style base
    autoLayout TopBottom
  }

  view petrest_backend_api of petrest.backend {
    title 'API / backend'
    description 'Контракт и потребители: каждый эндпоинт со своими вызывающими'
    include *
    include petrest.backend.api
    include petrest.backend.api.*
    include * -> petrest.backend.api.*
    global style base
    autoLayout LeftRight
  }
}
