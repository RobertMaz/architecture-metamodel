            confidence '1'
          }
        }

        delete_api_pettypes_p = operation 'DELETE /api/pettypes/{petTypeId}' {
          #inferred
          description 'Delete a pet type by ID'
          metadata {
            method 'DELETE'
            path '/api/pettypes/{petTypeId}'
            params 'petTypeId:path:integer'
            responses 'PetType'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        get_api_pettypes_p = operation 'GET /api/pettypes/{petTypeId}' {
          #inferred
          description 'Get a pet type by ID'
          metadata {
            method 'GET'
            path '/api/pettypes/{petTypeId}'
            params 'petTypeId:path:integer'
            responses 'PetType'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        put_api_pettypes_p = operation 'PUT /api/pettypes/{petTypeId}' {
          #inferred
          description 'Update a pet type by ID'
          metadata {
            method 'PUT'
