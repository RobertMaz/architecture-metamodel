      api_root = api 'root' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'root'
        }

        get = operation 'GET /' {
          #inferred
          description 'Корневой эндпоинт сервиса petrest.backend'
          metadata {
            method 'GET'
            path '/'
            source 'actuator:/mappings; src/main/java/org/springframework/samples/petclinic/rest/controller/v1/RootRestControllerV1.java#L41; llm:enrich'
            confidence '1'
          }
        }
      }

      api_specialties = api 'specialties' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'specialties'
        }

        get_api_specialties = operation 'GET /api/specialties' {
          #inferred
          description 'Lists specialties'
          metadata {
            method 'GET'
            path '/api/specialties'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        post_api_specialties = operation 'POST /api/specialties' {
          #inferred
          description 'Create a specialty'
          metadata {
            method 'POST'
            path '/api/specialties'
            request 'Specialty'
            responses 'Specialty'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        delete_api_specialties_p = operation 'DELETE /api/specialties/{specialtyId}' {
          #inferred
          description 'Delete a specialty by ID'
          metadata {
            method 'DELETE'
            path '/api/specialties/{specialtyId}'
            params 'specialtyId:path:integer'
            responses 'Specialty'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        get_api_specialties_p = operation 'GET /api/specialties/{specialtyId}' {
          #inferred
          description 'Get a specialty by ID'
          metadata {
            method 'GET'
            path '/api/specialties/{specialtyId}'
            params 'specialtyId:path:integer'
            responses 'Specialty'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        put_api_specialties_p = operation 'PUT /api/specialties/{specialtyId}' {
          #inferred
          description 'Update a specialty by ID'
          metadata {
            method 'PUT'
            path '/api/specialties/{specialtyId}'
            params 'specialtyId:path:integer'
            request 'Specialty'
            responses 'Specialty'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }
      }

      api_users = api 'users' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'users'
        }

        post_api_users = operation 'POST /api/users' {
          #inferred
          description 'Create a user'
          metadata {
            method 'POST'
            path '/api/users'
            request 'User'
            responses 'User'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }
      }

      api_vets = api 'vets' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'vets'
        }

        get_api_vets = operation 'GET /api/vets' {
          #inferred
          description 'Lists vets'
          metadata {
            method 'GET'
            path '/api/vets'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        post_api_vets = operation 'POST /api/vets' {
          #inferred
          description 'Create a Vet'
          metadata {
            method 'POST'
            path '/api/vets'
            request 'Vet'
            responses 'Vet'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        delete_api_vets_p = operation 'DELETE /api/vets/{vetId}' {
          #inferred
          description 'Delete a vet by ID'
          metadata {
            method 'DELETE'
            path '/api/vets/{vetId}'
            params 'vetId:path:integer'
            responses 'Vet'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        get_api_vets_p = operation 'GET /api/vets/{vetId}' {
          #inferred
          description 'Get a vet by ID'
          metadata {
            method 'GET'
            path '/api/vets/{vetId}'
            params 'vetId:path:integer'
            responses 'Vet'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        put_api_vets_p = operation 'PUT /api/vets/{vetId}' {
          #inferred
          description 'Update a vet  by ID'
          metadata {
            method 'PUT'
            path '/api/vets/{vetId}'
            params 'vetId:path:integer'
            request 'Vet'
            responses 'Vet'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }
      }

      api_visits = api 'visits' {
        #inferred #public
        technology 'HTTP/JSON'
        metadata {
          domain 'visits'
        }

        get_api_visits = operation 'GET /api/visits' {
          #inferred
          description 'Lists visits'
          metadata {
            method 'GET'
            path '/api/visits'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        post_api_visits = operation 'POST /api/visits' {
          #inferred
          description 'Create a visit'
          metadata {
            method 'POST'
            path '/api/visits'
            request 'Visit'
            responses 'Visit'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
        }

        delete_api_visits_p = operation 'DELETE /api/visits/{visitId}' {
          #inferred
          description 'Delete a visit by ID'
          metadata {
            method 'DELETE'
            path '/api/visits/{visitId}'
            params 'visitId:path:integer'
            responses 'Visit'
            source 'actuator:/mappings; src/main/resources/openapi.yml'
            confidence '1'
          }
