// СГЕНЕРИРОВАНО, РУКАМИ НЕ ПРАВИТЬ.
// Общие узлы: сторы и каналы. Идентичность — нормализованный адрес/топик:
// два сервиса с одним адресом сходятся в один узел, и инвариант
// «у store один писатель» превращается в детектор shared database.

model {
  extend petclinic {
    db_customers = store 'customers' {
      #inferred
      technology 'JDBC'
      metadata {
        entities 'Owner, Pet'
      }
    }

    db_vets = store 'vets' {
      #inferred
      technology 'JDBC'
      metadata {
        entities 'Vet'
      }
    }

    db_visits = store 'visits' {
      #inferred
      technology 'JDBC'
      metadata {
        entities 'Visit'
      }
    }
  }
}
