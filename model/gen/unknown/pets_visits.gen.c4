model {
  extend unknown {

    pets_visits = service '{_}pets/visits' {
      #stub #inferred
      technology 'неизвестно'
      metadata {
        url-templates '{_}pets/visits'
      }

      api = api '{_}pets/visits API' {
        #stub #inferred
        technology 'HTTP'
      }
    }
  }
}
