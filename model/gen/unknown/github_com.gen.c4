// СГЕНЕРИРОВАНО, РУКАМИ НЕ ПРАВИТЬ.
// Источник: registry/unresolved.json (stub нераспознанной цели)

model {
  extend unknown {

    github_com = service 'github.com' {
      #stub #inferred
      technology 'неизвестно'
      metadata {
        hosts 'github.com'
        roles 'config-repo'
        url-templates 'https://github.com/spring-petclinic/spring-petclinic-microservices-config'
      }

      api = api 'github.com API' {
        #stub #inferred
        technology 'HTTP'
      }
    }
  }
}
